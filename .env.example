# Google Sheets Configuration
# Copy this file to .env.local and fill in your values
# 
# To get these values from your Google Sheets URL:
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit?gid={GID}
# 
# Example:
# URL: https://docs.google.com/spreadsheets/d/1OxE-sFGQ4hqfpxsQGo3GdanjahIEPE-XxHOy-mDUmvw/edit?gid=0
# SPREADSHEET_ID = 1OxE-sFGQ4hqfpxsQGo3GdanjahIEPE-XxHOy-mDUmvw
# GID = 0

GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_GID=0
