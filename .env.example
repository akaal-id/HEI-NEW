# Google Sheets Configuration
# Copy this file to .env.local and fill in your values
# 
# To get these values from your Google Sheets URL:
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit?gid={GID}
# 
# Example:
# URL: https://docs.google.com/spreadsheets/d/1OxE-sFGQ4hqfpxsQGo3GdanjahIEPE-XxHOy-mDUmvw/edit?gid=0
# SPREADSHEET_ID = 1OxE-sFGQ4hqfpxsQGo3GdanjahIEPE-XxHOy-mDUmvw
# GID = 0

GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_GID=0

# Supabase - powers the /admin hero carousel dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Only this Supabase Auth account may use the /admin dashboard
ADMIN_EMAIL=admin@example.com
