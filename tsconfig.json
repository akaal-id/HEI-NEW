{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../../../../../../../../../../../var/folders/jk/8930bmds7f9325r7j_d6tpym0000gn/T/hei-2026-next/types/**/*.ts",
    "../../../../../../../../../../../../var/folders/jk/8930bmds7f9325r7j_d6tpym0000gn/T/hei-2026-next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
